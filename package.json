{
  "name": "telos",
  "version": "0.1.0",
  "private": true,
  "description": "TeLos is a premium interview intelligence and verified assessment platform.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsx watch server/index.ts\" \"wait-on http://localhost:5173 http://localhost:8787 && electron .\"",
    "web": "vite",
    "server": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "build:prod": "prisma generate && node scripts/setup-jdk.mjs && tsc -b && vite build",
    "start:prod": "tsx server/index.ts",
    "start": "electron .",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@convai/web-sdk": "^1.7.0",
    "@deepgram/sdk": "^3.9.0",
    "@google/generative-ai": "^0.24.1",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@prisma/client": "^6.2.1",
    "@types/three": "^0.185.4",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "openai": "^7.4.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0",
    "simli-client": "^3.0.2",
    "three": "^0.185.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^33.2.1",
    "postcss": "^8.4.49",
    "prisma": "^6.2.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  }
}
