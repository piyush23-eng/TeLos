# ==============================================================================
# TeLos Environment Configuration
# ==============================================================================

# Core LLM Provider (Required for dynamic AI interviews & debrief generation)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# PostgreSQL Database URL (Optional: defaults to local schema with in-memory fallback)
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/telos?schema=public"

# Application Server Port (Optional: default 8787)
# PORT=8787

# Authentication Session Secret (Recommended for production HMAC token signing)
# AUTH_SESSION_SECRET=generate_a_random_32_character_secret_here

# Optional: Default LLM Model via OpenRouter (default: meta-llama/llama-3.3-70b-instruct)
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Optional: Direct Speech & Audio Providers (falls back to native browser speech if omitted)
# DEEPGRAM_API_KEY=your_deepgram_api_key_here
# ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# Optional: Third-party OAuth Providers (Email authentication works out of the box)
# GOOGLE_CLIENT_ID=your_google_oauth_client_id
# GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
# LINKEDIN_CLIENT_ID=your_linkedin_client_id
# LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
