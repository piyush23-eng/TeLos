# Local backend URL for the frontend
i.e. Vite should proxy API calls when you start dev mode.
VITE_API_BASE_URL=http://localhost:8787
PORT=8787

# Leave blank to use the fully functional demo provider.
DEEPGRAM_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
DATABASE_URL="file:./dev.db"

# Optional Gemini model override
GEMINI_MODEL=gemini-2.0-flash

# Authentication (create a Google Web OAuth client and use its client ID in both values)
AUTH_SESSION_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
