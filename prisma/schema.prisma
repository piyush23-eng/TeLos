generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id          String   @id @default(cuid())
  company     String
  role        String
  persona     String
  startedAt   DateTime @default(now())
  durationMin Int      @default(0)
  starScore   Float    @default(0)
  accuracy    Float    @default(0)
  fillerRate  Float    @default(0)
  questions   Question[]
  scores      Score[]
}

model Question {
  id        String   @id @default(cuid())
  sessionId String
  prompt    String
  category  String
  answer    String?
  createdAt DateTime @default(now())
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model Score {
  id          String   @id @default(cuid())
  sessionId   String
  timestamp   Int
  pacingWpm   Int
  fillerCount Int
  starScore   Float
  accuracy    Float
  session     Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model Problem {
  id          String @id @default(cuid())
  title       String @unique
  difficulty  String
  category    String
  description String
  starterCode String
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String?
  provider     String   @default("email")
  bio          String   @default("")
  linkedin     String   @default("")
  github       String   @default("")
  experience   String   @default("")
  projects     String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
